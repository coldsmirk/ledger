{
  "name": "ledger",
  "version": "0.9.0",
  "private": true,
  "description": "A Mantine-native DataTable built on TanStack Table and TanStack Virtual.",
  "license": "MIT",
  "author": {
    "name": "Venus"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "check:package": "pnpm -r --filter \"@coldsmirk/*\" exec publint && pnpm -r --filter \"@coldsmirk/*\" exec attw --pack .",
    "clean": "pnpm -r run clean",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "lint:css": "stylelint --fix \"packages/*/src/**/*.css\"",
    "lint:css:check": "stylelint \"packages/*/src/**/*.css\"",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r run typecheck",
    "version:major": "jiti scripts/version.ts major",
    "version:minor": "jiti scripts/version.ts minor",
    "version:patch": "jiti scripts/version.ts patch"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "eslint --fix",
    "{package.json,tsconfig.json,tsconfig.*.json}": "eslint --fix",
    "*.css": "stylelint --fix"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@coldsmirk/commitlint-config": "^0.8.2",
    "@coldsmirk/eslint-config": "^0.8.2",
    "@coldsmirk/stylelint-config": "^0.8.2",
    "@coldsmirk/tsconfig": "^0.8.2",
    "@commitlint/cli": "^21.2.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "stylelint": "^17.16.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  }
}
