{
  // Repo-wide bridge over the shared preset (github.com/coldsmirk/canon); only the knobs the
  // preset deliberately leaves to the project live here.
  "extends": "@coldsmirk/tsconfig/react",
  "compilerOptions": {
    // Workspace imports resolve to package TypeScript sources (the `source` export condition), so
    // typecheck and tests run against source with no build step.
    "customConditions": ["source"],
    // No ambient type injection: package sources must not see node/test globals (a stray
    // `process.env.X` in browser code should fail typecheck). Tests import what they use, and the
    // root tsconfig re-adds `node` for the repo-level config files it covers.
    "types": [],
    "noEmit": true
  }
}
